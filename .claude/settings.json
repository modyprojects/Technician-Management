{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./docs/review/**/*.png)",
      "Read(./docs/review/**/*.webp)",
      "Read(./docs/history/**)",
      "Read(./package-lock.json)",
      "Read(./playwright-report/**)",
      "Read(./test-results/**)",
      "Read(./.env*)",
      "mcp__Supabase__list_projects",
      "mcp__Supabase__get_organization",
      "mcp__Supabase__list_organizations",
      "mcp__Supabase__create_project",
      "mcp__Supabase__pause_project",
      "mcp__Supabase__restore_project",
      "mcp__Supabase__create_branch",
      "mcp__Supabase__delete_branch",
      "mcp__Supabase__merge_branch",
      "mcp__Supabase__reset_branch",
      "mcp__Supabase__rebase_branch",
      "mcp__Supabase__create_edge_function_secret"
    ],
    "ask": [
      "mcp__Supabase__apply_migration"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Supabase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/supabase-guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
