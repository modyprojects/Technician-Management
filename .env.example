# Example VARIABLE NAMES only. Do not enter real credentials into source control or chat.
# Public by design; publishable key requires robust RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Set in secure provider settings when approved; never expose to browser.
SUPABASE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
# Email delivery (D65): disabled (default when unset) | mock (local runs and CI only: refused
# wherever VERCEL_ENV is set, and needs MAIL_MOCK_FILE) | resend (dormant: needs the two values
# above, a verified sending domain, the owner's approval and the go-live steps of
# docs/integrations.md "Email" first).
EMAIL_DELIVERY=
# LOCAL TESTS ONLY: absolute path of the file the mock delivery appends to (tests/auth/run-local.mjs).
MAIL_MOCK_FILE=
# Origin for links in emails (D65), e.g. reset links; never taken from the request. Unset on Vercel
# (its system variables give the Production or Preview address); locally http://localhost:3000.
APP_ORIGIN=
TRANSCRIPTION_PROVIDER_API_KEY=
# LOCAL ONLY (never define in Vercel): set to 1 to open /dev routes on localhost.
ENABLE_DEV_ROUTES=
# Outlook invitation simulator (D24, D90): set to 1 in development, Preview and Production (owner).
# On Vercel Production it works only while config/release.json testingPeriod is true; off from go-live.
CALENDAR_SIMULATOR=
