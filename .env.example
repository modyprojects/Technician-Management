# Example VARIABLE NAMES only. Do not enter real credentials into source control or chat.
# Public by design; publishable key requires robust RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Set in secure provider settings when approved; never expose to browser.
SUPABASE_SECRET_KEY=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
TRANSCRIPTION_PROVIDER_API_KEY=
# LOCAL ONLY (never define in Vercel): set to 1 to open /dev routes on localhost.
ENABLE_DEV_ROUTES=
# Outlook invitation simulator (D24): set to 1 only in development and Preview. Always off on
# Vercel Production, whatever the value (never enabled there without the owner's approval).
CALENDAR_SIMULATOR=
