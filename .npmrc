# Supply-chain hygiene (Step 0 plan, approved 2026-11-01).
# Exact versions only.
save-exact=true
# Never run install scripts of third-party packages.
ignore-scripts=true
# Cooldown: do not resolve package versions published less than 7 days ago (npm >= 11.10).
# Enforced when the lockfile is created or changed; `npm ci` replays the committed lockfile.
# npm < 11.10 silently ignores this setting: change the lockfile only with
#   npx -y npm@11.19.1 install --save-exact <package>@<version>
min-release-age=7
